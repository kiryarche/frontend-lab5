{
  "info": {
    "_postman_id": "2e9f3a4d-33b8-4b0e-8e92-5f0f5178c5a1",
    "name": "Toolkit Postman Lab",
    "description": "Requests for lab work: VK, GeoIP, ReqRes register and login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET VK",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response has Content-Type header', function () {",
              "  pm.expect(pm.response.headers.has('Content-Type')).to.eql(true);",
              "});",
              "pm.test('Response has a status code', function () {",
              "  pm.expect(pm.response.code).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{vkUrl}}",
          "host": [
            "{{vkUrl}}"
          ]
        },
        "description": "GET request to VK. In Postman the response is available because Postman is not restricted by browser CORS. Check Content-Type, cookies/security headers and CORS-related headers."
      },
      "response": []
    },
    {
      "name": "GET GeoIP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is JSON', function () {",
              "  pm.response.to.be.json;",
              "});",
              "pm.test('Response contains IP field', function () {",
              "  pm.expect(pm.response.json()).to.have.property('ip');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{geoipUrl}}",
          "host": [
            "{{geoipUrl}}"
          ]
        },
        "description": "GET request to GeoIP API. Check Content-Type and Access-Control-Allow-Origin headers."
      },
      "response": []
    },
    {
      "name": "GET ReqRes Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains users list', function () {",
              "  pm.expect(pm.response.json()).to.have.property('data');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{reqresApiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{reqresBaseUrl}}/users",
          "host": [
            "{{reqresBaseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "List of prepared users for register/login tasks."
      },
      "response": []
    },
    {
      "name": "POST ReqRes Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains token', function () {",
              "  pm.expect(pm.response.json()).to.have.property('token');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{reqresApiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "eve.holt@reqres.in",
              "type": "text"
            },
            {
              "key": "password",
              "value": "123456",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{reqresBaseUrl}}/register",
          "host": [
            "{{reqresBaseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Register request. Body encoding is x-www-form-urlencoded with email and password fields."
      },
      "response": []
    },
    {
      "name": "POST ReqRes Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains token', function () {",
              "  pm.expect(pm.response.json()).to.have.property('token');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{reqresApiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{reqresBaseUrl}}/login",
          "host": [
            "{{reqresBaseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Login request. Body is a JSON object with email and password fields."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "vkUrl",
      "value": "https://vk.com",
      "type": "string"
    },
    {
      "key": "geoipUrl",
      "value": "https://json.geoiplookup.io/",
      "type": "string"
    },
    {
      "key": "reqresBaseUrl",
      "value": "https://reqres.in/api",
      "type": "string"
    },
    {
      "key": "reqresApiKey",
      "value": "reqres-free-v1",
      "type": "string"
    }
  ]
}
